# Railway Environment Configuration
# This file contains environment-specific settings for Railway deployment

# Backend server configuration
NODE_ENV=production
PORT=5000

# Database configuration (Set in Railway UI)
# MONGODB_URI=your_mongodb_connection_string

# Frontend URL (Set in Railway UI)
# FRONTEND_URL=your_railway_frontend_url

# Twilio configuration (Set in Railway UI)
# TWILIO_ACCOUNT_SID=your_account_sid
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_NUMBER=your_phone_number
