# MongoDB Connection String (REQUIRED)
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/database
# Example: mongodb+srv://G-tech:gmfdeboss988@cluster0.wkaui.mongodb.net/moneypay?retryWrites=true&w=majority&appName=Cluster0
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/moneypay?retryWrites=true&w=majority&appName=Cluster0

# Node Environment
NODE_ENV=production

# Server Port
PORT=5000

# Frontend URL (for CORS)
# Get this from Railway Frontend Service → Settings → Public URL
# See FIND_RAILWAY_URLS.md for detailed instructions
FRONTEND_URL=https://your-frontend-url.railway.app

# Twilio SMS Configuration
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
