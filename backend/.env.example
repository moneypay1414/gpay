# Backend Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# LOCAL DEVELOPMENT (.env file)
# ============================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database - Local MongoDB
MONGODB_URI=mongodb://localhost:27017/moneypay

# JWT Secret (generate a strong random string)
JWT_SECRET=your-super-secret-jwt-key-here-make-it-long-and-random

# Frontend URL (for CORS - use localhost for development)
FRONTEND_URL=http://localhost:5173

# Twilio SMS Configuration (optional)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# Socket.io Configuration
SOCKET_CORS_ORIGIN=http://localhost:5173

# ============================================
# PRODUCTION ON RAILWAY (Set in Railway UI)
# ============================================
# DON'T set these in .env file - set in Railway Dashboard → Variables
#
# NODE_ENV=production
# PORT=5000
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/moneypay
# FRONTEND_URL=https://your-frontend-url-from-railway.railway.app
# TWILIO_ACCOUNT_SID=your-twilio-account-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_PHONE_NUMBER=your-twilio-phone-number
#
# See FIND_RAILWAY_URLS.md for how to get your Railway URLs